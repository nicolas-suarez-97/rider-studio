# ===================================================
# SUPABASE CONFIGURATION (Base de datos y Storage)
# Obtén estas credenciales en: https://supabase.com -> Project Settings -> API
# ===================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===================================================
# VERCEL AI GATEWAY CONFIGURATION
# Obtén tu key ejecutando: npx vercel ai-gateway setup
# ===================================================
AI_GATEWAY_API_KEY=vck_...
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# ===================================================
# DIRECT PROVIDER KEYS (Opcional - contingencia sin Gateway)
# ===================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
